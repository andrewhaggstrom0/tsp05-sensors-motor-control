# ROS 2 build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Arduino / PlatformIO
firmware/**/build/
.pio/

# Editors / OS
.vscode/
.idea/
.DS_Store
